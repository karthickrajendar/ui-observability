{
  "name": "@ui-observability/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ui-observability/contracts": "0.0.1"
  },
  "nx": {
    "name": "observability-api",
    "targets": {
      "serve": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsx watch src/main.ts",
          "cwd": "apps/observability-api"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "command": "node build.mjs",
          "cwd": "apps/observability-api"
        }
      }
    }
  }
}
