{
  "title": "Frontend Performance",
  "uid": "frontend-performance",
  "description": "Core Web Vitals (LCP, INP, CLS, FCP, TTFB), Main-Thread Long Tasks, Custom Domain SLIs, Fetch Latency, and OpenTelemetry Distributed Traces in Tempo.",
  "tags": ["frontend-observability", "performance", "lgtm"],
  "timezone": "browser",
  "schemaVersion": 41,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "links": [
    {
      "title": "Frontend Observability Dashboards",
      "type": "dashboards",
      "tags": ["frontend-observability"],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "app_name",
        "label": "App",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "type": 1, "label": "app_name", "stream": "{job=\"faro\"}" },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "app_environment",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "type": 1, "label": "app_environment", "stream": "{job=\"faro\"}" },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "app_release",
        "label": "Release",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "type": 1, "label": "app_release", "stream": "{job=\"faro\"}" },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Core Web Vitals Scorecards (p75 Google Thresholds)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 20,
      "type": "gauge",
      "title": "LCP p75 (Good < 2500ms)",
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "max": 5000,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2500 },
              { "color": "red", "value": 4000 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "showThresholdMarkers": true, "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "quantile_over_time(0.75, {job=\"faro\", kind=\"measurement\", app_name=~\"$app_name\", app_environment=~\"$app_environment\", app_release=~\"$app_release\"} | logfmt | unwrap value_lcp | __error__=`` [$__range])",
          "queryType": "instant"
        }
      ]
    },
