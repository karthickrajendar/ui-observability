    {
      "id": 6,
      "type": "timeseries",
      "title": "Route & Logical View Changes",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 75,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (event_data_toRoute, event_data_toView) (count_over_time({job=\"faro\", kind=\"event\", app_name=~\"$app_name\", app_environment=~\"$app_environment\", app_release=~\"$app_release\"} | logfmt | event_name=~\"route_change|view_changed\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{event_data_toRoute}}{{event_data_toView}}"
        }
      ]
